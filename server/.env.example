PORT=4000
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Step 6.1 · MySQL 8 (Prisma). Format: mysql://USER:PASSWORD@HOST:PORT/NAMA_DATABASE
# Buat database kosong lebih dulu, mis.: CREATE DATABASE oven_and_co CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# `prisma migrate dev` juga membuat shadow database sementara, jadi user MySQL perlu hak CREATE DATABASE.
DATABASE_URL=mysql://root:password@localhost:3306/oven_and_co
# Opsional: tanggal acuan data contoh seed (YYYY-MM-DD). Default 2026-10-16 (sama dengan uji frontend).
# SEED_ANCHOR_DATE=2026-10-16

# Diisi mulai Step 6.2 (auth API)
# JWT_SECRET=replace-with-a-random-secret
# JWT_EXPIRES_IN=1d

# Step 6.3 · Opsional: kunci HMAC token desain custom cake tamu. Bila kosong, kunci diturunkan dari JWT_SECRET.
# Mengganti nilai ini membuat token desain tamu lama tidak berlaku (desain harus dibuat ulang).
# DESIGN_TOKEN_SECRET=replace-with-another-random-secret

# Step 6.3 · Opsional: folder file unggahan lokal (default server/uploads; sudah di .gitignore)
# UPLOAD_DIR=./uploads
