{
  "name": "oven-and-co-server",
  "version": "1.0.0",
  "description": "Backend API Oven & Co. — Express + Prisma + MySQL",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "db:check-spec": "node prisma/checkSchemaAgainstSpec.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcrypt": "6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "2.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "prisma": "6.19.3"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
