// prisma/schema.prisma
// Step 6.1 · 29 tabel persis sesuai docs/SPEC.md §8 (Data Dictionary, Oven_and_Co_Analisis_Perancangan_Sistem.pdf Bab 4.5)
//
// Konvensi: model PascalCase & field camelCase di kode, dipetakan ke nama tabel/kolom snake_case lewat @@map/@map.
// Tipe & panjang mengikuti data dictionary: BIGINT → BigInt, INT → Int, TINYINT/SMALLINT → @db.TinyInt/@db.SmallInt,
// VARCHAR(n) → @db.VarChar(n), DECIMAL(p,s) → @db.Decimal(p,s), DATE → @db.Date, TIME → @db.Time(0),
// DATETIME → @db.DateTime(0), BOOLEAN → Boolean (TINYINT(1)).
// Tidak ada kolom di luar SPEC. Nilai turunan (saldo poin, level, sisa stok, subtotal item) TIDAK disimpan.
// @default hanya ditambahkan pada id auto-increment, waktu dibuat/diubah, dan flag boolean (bukan kolom baru) — lihat
// catatan Step 6.1 di docs/ROADMAP.md.
// onDelete: Restrict untuk semua relasi (relasi opsional ditulis eksplisit, karena default Prisma = SetNull yang akan
// mengosongkan rujukan di pesanan lama). Riwayat transaksi tidak boleh berubah diam-diam (PDF 4.1; A-05 produk/varian
// hanya dinonaktifkan). Cascade hanya untuk tabel penghubung M:N dan isi keranjang.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ── Enum (nilai persis SPEC §4 & §8) ─────────────────────────────────────────────────────────────

enum UserRole {
  customer
  owner
  staf
}

enum NotificationType {
  order_status
  promo
  points
}

enum AvailabilityType {
  ready
  preorder
  custom
}

enum CustomOptionGroup {
  ukuran
  bentuk
  rasa
  krim_topping
}

enum FulfillmentType {
  pickup
  delivery
}

enum PaymentOption {
  online
  pay_at_store
}

enum PaymentStatus {
  unpaid
  paid
  refunded
}

/// SPEC §4 — dipakai orders.order_status & order_status_histories.status
enum OrderStatus {
  menunggu_pembayaran
  dikonfirmasi
  sedang_disiapkan
  siap_diambil
  dalam_pengiriman
  selesai
  dibatalkan
}

/// payments.status
enum PaymentTransactionStatus {
  pending
  paid
  expired
  failed
  refunded
}

enum DiscountType {
  percent
  amount
}

enum PointTransactionType {
  earn
  redeem
  review_bonus
  refund
}

enum PaymentMethodGroup {
  qris
  ewallet
  va
  store
}

// ── Pengguna & akses ─────────────────────────────────────────────────────────────────────────────

/// Akun pelanggan dan admin
model User {
  userId       BigInt   @id @default(autoincrement()) @map("user_id")
  name         String   @db.VarChar(100)
  email        String   @unique @db.VarChar(150)
  phone        String   @unique @db.VarChar(20)
  /// Kosong bila hanya login Google
  passwordHash String?  @map("password_hash") @db.VarChar(255)
  googleId     String?  @unique @map("google_id") @db.VarChar(100)
  role         UserRole
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(0)

  addresses         Address[]
  passwordResets    PasswordReset[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  customCakeDesigns CustomCakeDesign[]
  carts             Cart[]
  orders            Order[]
  statusChanges     OrderStatusHistory[]
  userVouchers      UserVoucher[]
  pointTransactions PointTransaction[]
  reviews           Review[]
  wishlists         Wishlist[]

  @@map("users")
}

/// Alamat tersimpan pelanggan
model Address {
  addressId      BigInt  @id @default(autoincrement()) @map("address_id")
  userId         BigInt  @map("user_id")
  label          String  @db.VarChar(30)
  recipientName  String  @map("recipient_name") @db.VarChar(100)
  recipientPhone String  @map("recipient_phone") @db.VarChar(20)
  fullAddress    String  @map("full_address") @db.Text
  latitude       Decimal @db.Decimal(10, 7)
  longitude      Decimal @db.Decimal(10, 7)
  courierNote    String? @map("courier_note") @db.VarChar(255)
  isPrimary      Boolean @default(false) @map("is_primary")

  user   User    @relation(fields: [userId], references: [userId])
  orders Order[]

  @@map("addresses")
}

/// OTP atur ulang kata sandi
model PasswordReset {
  resetId   BigInt    @id @default(autoincrement()) @map("reset_id")
  userId    BigInt    @map("user_id")
  otpHash   String    @map("otp_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.DateTime(0)
  usedAt    DateTime? @map("used_at") @db.DateTime(0)

  user User @relation(fields: [userId], references: [userId])

  @@map("password_resets")
}

/// Notifikasi in-app pelanggan
model Notification {
  notificationId BigInt           @id @default(autoincrement()) @map("notification_id")
  userId         BigInt           @map("user_id")
  type           NotificationType
  title          String           @db.VarChar(100)
  body           String           @db.VarChar(255)
  orderId        BigInt?          @map("order_id")
  isRead         Boolean          @default(false) @map("is_read")
  createdAt      DateTime         @default(now()) @map("created_at") @db.DateTime(0)

  user  User   @relation(fields: [userId], references: [userId])
  order Order? @relation(fields: [orderId], references: [orderId], onDelete: Restrict)

  @@map("notifications")
}

/// Riwayat aktivitas admin (FR-37, Could)
model AuditLog {
  logId     BigInt   @id @default(autoincrement()) @map("log_id")
  /// Admin pelaku
  userId    BigInt   @map("user_id")
  action    String   @db.VarChar(50)
  entity    String   @db.VarChar(50)
  entityId  BigInt   @map("entity_id")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)

  user User @relation(fields: [userId], references: [userId])

  @@map("audit_logs")
}

// ── Produk, custom cake & stok ───────────────────────────────────────────────────────────────────

model Category {
  categoryId Int    @id @default(autoincrement()) @map("category_id")
  name       String @unique @db.VarChar(50)
  sortOrder  Int    @map("sort_order")

  products Product[]

  @@map("categories")
}

/// Master produk
model Product {
  productId        BigInt           @id @default(autoincrement()) @map("product_id")
  categoryId       Int              @map("category_id")
  name             String           @db.VarChar(100)
  description      String           @db.Text
  ingredients      String?          @db.Text
  allergens        String?          @db.VarChar(255)
  price            Decimal          @db.Decimal(12, 2)
  availabilityType AvailabilityType @map("availability_type")
  /// 0 = ready, 1 = pre-order H-1, 3 = custom H-3
  leadTimeDays     Int              @map("lead_time_days") @db.TinyInt
  isActive         Boolean          @default(true) @map("is_active")

  category          Category           @relation(fields: [categoryId], references: [categoryId])
  images            ProductImage[]
  variants          ProductVariant[]
  dailyStocks       DailyStock[]
  customCakeDesigns CustomCakeDesign[]
  cartItems         CartItem[]
  orderItems        OrderItem[]
  vouchers          Voucher[]
  wishlists         Wishlist[]

  @@map("products")
}

/// Foto produk (maks. 5 — divalidasi aplikasi)
model ProductImage {
  imageId   BigInt @id @default(autoincrement()) @map("image_id")
  productId BigInt @map("product_id")
  imageUrl  String @map("image_url") @db.VarChar(255)
  sortOrder Int    @map("sort_order") @db.TinyInt

  product Product @relation(fields: [productId], references: [productId])

  @@map("product_images")
}

model ProductVariant {
  variantId  BigInt  @id @default(autoincrement()) @map("variant_id")
  productId  BigInt  @map("product_id")
  name       String  @db.VarChar(50)
  extraPrice Decimal @map("extra_price") @db.Decimal(12, 2)
  isActive   Boolean @default(true) @map("is_active")

  product    Product     @relation(fields: [productId], references: [productId])
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@map("product_variants")
}

/// Stok produk ready per hari; sisa = qty_planned - qty_sold (tidak disimpan)
model DailyStock {
  stockId    BigInt   @id @default(autoincrement()) @map("stock_id")
  productId  BigInt   @map("product_id")
  stockDate  DateTime @map("stock_date") @db.Date
  qtyPlanned Int      @map("qty_planned")
  qtySold    Int      @map("qty_sold")

  product Product @relation(fields: [productId], references: [productId])

  @@unique([productId, stockDate])
  @@map("daily_stocks")
}

/// Stok bahan baku utama
model RawMaterial {
  materialId BigInt  @id @default(autoincrement()) @map("material_id")
  name       String  @db.VarChar(100)
  unit       String  @db.VarChar(20)
  stock      Decimal @db.Decimal(10, 2)
  minStock   Decimal @map("min_stock") @db.Decimal(10, 2)

  @@map("raw_materials")
}

/// Opsi Custom Cake Builder
model CustomOption {
  optionId    Int               @id @default(autoincrement()) @map("option_id")
  optionGroup CustomOptionGroup @map("option_group")
  name        String            @db.VarChar(50)
  description String?           @db.VarChar(100)
  extraPrice  Decimal           @map("extra_price") @db.Decimal(12, 2)
  imageUrl    String?           @map("image_url") @db.VarChar(255)
  isActive    Boolean           @default(true) @map("is_active")

  designOptions CustomCakeDesignOption[]

  @@map("custom_options")
}

/// Desain custom cake pelanggan
model CustomCakeDesign {
  designId          BigInt   @id @default(autoincrement()) @map("design_id")
  productId         BigInt   @map("product_id")
  /// Kosong bila tamu
  userId            BigInt?  @map("user_id")
  writingText       String?  @map("writing_text") @db.VarChar(30)
  writingColor      String?  @map("writing_color") @db.VarChar(20)
  referencePhotoUrl String?  @map("reference_photo_url") @db.VarChar(255)
  /// ≥ H+3
  readyDate         DateTime @map("ready_date") @db.Date
  price             Decimal  @db.Decimal(12, 2)

  product    Product                  @relation(fields: [productId], references: [productId])
  user       User?                    @relation(fields: [userId], references: [userId], onDelete: Restrict)
  options    CustomCakeDesignOption[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@map("custom_cake_designs")
}

/// Opsi terpilih per desain (M:N custom_cake_designs – custom_options)
model CustomCakeDesignOption {
  designId BigInt @map("design_id")
  optionId Int    @map("option_id")

  design CustomCakeDesign @relation(fields: [designId], references: [designId], onDelete: Cascade)
  option CustomOption     @relation(fields: [optionId], references: [optionId], onDelete: Cascade)

  @@id([designId, optionId])
  @@map("custom_cake_design_options")
}

// ── Keranjang, pesanan & pembayaran ──────────────────────────────────────────────────────────────

/// Keranjang pengguna/tamu
model Cart {
  cartId       BigInt   @id @default(autoincrement()) @map("cart_id")
  /// Kosong bila tamu
  userId       BigInt?  @map("user_id")
  sessionToken String?  @unique @map("session_token") @db.VarChar(64)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)

  user  User?      @relation(fields: [userId], references: [userId], onDelete: Restrict)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  cartItemId    BigInt    @id @default(autoincrement()) @map("cart_item_id")
  cartId        BigInt    @map("cart_id")
  productId     BigInt    @map("product_id")
  variantId     BigInt?   @map("variant_id")
  designId      BigInt?   @map("design_id")
  quantity      Int
  note          String?   @db.VarChar(255)
  preferredDate DateTime? @map("preferred_date") @db.Date

  cart    Cart              @relation(fields: [cartId], references: [cartId], onDelete: Cascade)
  product Product           @relation(fields: [productId], references: [productId])
  variant ProductVariant?   @relation(fields: [variantId], references: [variantId], onDelete: Restrict)
  design  CustomCakeDesign? @relation(fields: [designId], references: [designId], onDelete: Restrict)

  @@map("cart_items")
}

/// Pesanan
model Order {
  orderId                 BigInt          @id @default(autoincrement()) @map("order_id")
  /// OVC-YYMMDD-NNN
  orderNumber             String          @unique @map("order_number") @db.VarChar(20)
  userId                  BigInt          @map("user_id")
  fulfillmentType         FulfillmentType @map("fulfillment_type")
  addressId               BigInt?         @map("address_id")
  deliveryAddressSnapshot String?         @map("delivery_address_snapshot") @db.Text
  distanceKm              Decimal?        @map("distance_km") @db.Decimal(5, 2)
  /// BR-03
  readyDate               DateTime        @map("ready_date") @db.Date
  timeSlot                String          @map("time_slot") @db.VarChar(20)
  subtotal                Decimal         @db.Decimal(12, 2)
  shippingFee             Decimal         @map("shipping_fee") @db.Decimal(12, 2)
  voucherId               BigInt?         @map("voucher_id")
  voucherDiscount         Decimal         @map("voucher_discount") @db.Decimal(12, 2)
  pointsUsed              Int             @map("points_used")
  pointsDiscount          Decimal         @map("points_discount") @db.Decimal(12, 2)
  total                   Decimal         @db.Decimal(12, 2)
  paymentOption           PaymentOption   @map("payment_option")
  paymentStatus           PaymentStatus   @map("payment_status")
  orderStatus             OrderStatus     @map("order_status")
  pickupCode              String?         @map("pickup_code") @db.VarChar(10)
  courierName             String?         @map("courier_name") @db.VarChar(100)
  cancelReason            String?         @map("cancel_reason") @db.VarChar(255)
  createdAt               DateTime        @default(now()) @map("created_at") @db.DateTime(0)

  user              User                 @relation(fields: [userId], references: [userId])
  address           Address?             @relation(fields: [addressId], references: [addressId], onDelete: Restrict)
  voucher           Voucher?             @relation(fields: [voucherId], references: [voucherId], onDelete: Restrict)
  items             OrderItem[]
  payments          Payment[]
  statusHistories   OrderStatusHistory[]
  notifications     Notification[]
  pointTransactions PointTransaction[]

  @@map("orders")
}

model OrderItem {
  orderItemId BigInt  @id @default(autoincrement()) @map("order_item_id")
  orderId     BigInt  @map("order_id")
  productId   BigInt  @map("product_id")
  variantId   BigInt? @map("variant_id")
  designId    BigInt? @map("design_id")
  quantity    Int
  /// Salinan harga saat pesan
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  note        String? @db.VarChar(255)

  order   Order             @relation(fields: [orderId], references: [orderId])
  product Product           @relation(fields: [productId], references: [productId])
  variant ProductVariant?   @relation(fields: [variantId], references: [variantId], onDelete: Restrict)
  design  CustomCakeDesign? @relation(fields: [designId], references: [designId], onDelete: Restrict)
  review  Review?

  @@map("order_items")
}

/// Transaksi pembayaran (1 pesanan dapat punya beberapa percobaan)
model Payment {
  paymentId   BigInt                   @id @default(autoincrement()) @map("payment_id")
  orderId     BigInt                   @map("order_id")
  methodCode  String                   @map("method_code") @db.VarChar(20)
  amount      Decimal                  @db.Decimal(12, 2)
  gatewayRef  String?                  @map("gateway_ref") @db.VarChar(100)
  /// QR string atau nomor VA
  paymentCode String?                  @map("payment_code") @db.VarChar(255)
  status      PaymentTransactionStatus
  /// Batas bayar (30 menit, BR-06)
  expiredAt   DateTime                 @map("expired_at") @db.DateTime(0)
  paidAt      DateTime?                @map("paid_at") @db.DateTime(0)

  order  Order         @relation(fields: [orderId], references: [orderId])
  method PaymentMethod @relation(fields: [methodCode], references: [methodCode])

  @@map("payments")
}

/// Riwayat status pesanan
model OrderStatusHistory {
  historyId BigInt      @id @default(autoincrement()) @map("history_id")
  orderId   BigInt      @map("order_id")
  status    OrderStatus
  /// Admin pengubah; kosong bila sistem
  changedBy BigInt?     @map("changed_by")
  note      String?     @db.VarChar(255)
  changedAt DateTime    @default(now()) @map("changed_at") @db.DateTime(0)

  order   Order @relation(fields: [orderId], references: [orderId])
  changer User? @relation(fields: [changedBy], references: [userId], onDelete: Restrict)

  @@map("order_status_histories")
}

/// Metode pembayaran (qris, gopay, ovo, dana, shopeepay, va_bca, va_bni, va_mandiri, va_bri, pay_at_store)
model PaymentMethod {
  methodCode  String             @id @map("method_code") @db.VarChar(20)
  name        String             @db.VarChar(50)
  methodGroup PaymentMethodGroup @map("method_group")
  isActive    Boolean            @default(true) @map("is_active")

  payments Payment[]

  @@map("payment_methods")
}

// ── Promo, loyalty & ulasan ──────────────────────────────────────────────────────────────────────

/// Master voucher
model Voucher {
  voucherId     BigInt       @id @default(autoincrement()) @map("voucher_id")
  code          String       @unique @db.VarChar(20)
  title         String       @db.VarChar(100)
  discountType  DiscountType @map("discount_type")
  discountValue Decimal      @map("discount_value") @db.Decimal(12, 2)
  /// Kosong = semua produk
  productId     BigInt?      @map("product_id")
  quota         Int
  validFrom     DateTime     @map("valid_from") @db.Date
  validTo       DateTime     @map("valid_to") @db.Date
  isActive      Boolean      @default(true) @map("is_active")

  product      Product?      @relation(fields: [productId], references: [productId], onDelete: Restrict)
  orders       Order[]
  userVouchers UserVoucher[]

  @@map("vouchers")
}

/// Voucher milik pelanggan (M:N users – vouchers)
model UserVoucher {
  userId    BigInt    @map("user_id")
  voucherId BigInt    @map("voucher_id")
  claimedAt DateTime  @default(now()) @map("claimed_at") @db.DateTime(0)
  usedAt    DateTime? @map("used_at") @db.DateTime(0)

  user    User    @relation(fields: [userId], references: [userId], onDelete: Cascade)
  voucher Voucher @relation(fields: [voucherId], references: [voucherId], onDelete: Cascade)

  @@id([userId, voucherId])
  @@map("user_vouchers")
}

/// Mutasi poin loyalty — saldo = Σ points (tidak disimpan)
model PointTransaction {
  pointTxId BigInt               @id @default(autoincrement()) @map("point_tx_id")
  userId    BigInt               @map("user_id")
  type      PointTransactionType
  /// +/-
  points    Int
  orderId   BigInt?              @map("order_id")
  reviewId  BigInt?              @map("review_id")
  createdAt DateTime             @default(now()) @map("created_at") @db.DateTime(0)

  user   User    @relation(fields: [userId], references: [userId])
  order  Order?  @relation(fields: [orderId], references: [orderId], onDelete: Restrict)
  review Review? @relation(fields: [reviewId], references: [reviewId], onDelete: Restrict)

  @@map("point_transactions")
}

/// Ulasan produk — satu ulasan per item pesanan (BR-11)
model Review {
  reviewId    BigInt   @id @default(autoincrement()) @map("review_id")
  userId      BigInt   @map("user_id")
  orderItemId BigInt   @unique @map("order_item_id")
  /// 1 sampai 5
  rating      Int      @db.TinyInt
  tags        String?  @db.VarChar(255)
  comment     String?  @db.Text
  isHidden    Boolean  @default(false) @map("is_hidden")
  adminReply  String?  @map("admin_reply") @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(0)

  user              User               @relation(fields: [userId], references: [userId])
  orderItem         OrderItem          @relation(fields: [orderItemId], references: [orderItemId])
  photos            ReviewPhoto[]
  pointTransactions PointTransaction[]

  @@map("reviews")
}

/// Foto ulasan (maks. 3 — divalidasi aplikasi)
model ReviewPhoto {
  photoId  BigInt @id @default(autoincrement()) @map("photo_id")
  reviewId BigInt @map("review_id")
  photoUrl String @map("photo_url") @db.VarChar(255)

  review Review @relation(fields: [reviewId], references: [reviewId])

  @@map("review_photos")
}

/// Produk favorit pelanggan (M:N users – products)
model Wishlist {
  userId    BigInt   @map("user_id")
  productId BigInt   @map("product_id")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)

  user    User    @relation(fields: [userId], references: [userId], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [productId], onDelete: Cascade)

  @@id([userId, productId])
  @@map("wishlists")
}

// ── Konfigurasi toko ─────────────────────────────────────────────────────────────────────────────

/// Pengaturan toko — satu baris, setting_id selalu 1
model StoreSetting {
  settingId             Int       @id @map("setting_id") @db.TinyInt
  storeName             String    @map("store_name") @db.VarChar(100)
  address               String?   @db.Text
  latitude              Decimal?  @db.Decimal(10, 7)
  longitude             Decimal?  @db.Decimal(10, 7)
  whatsappNumber        String?   @map("whatsapp_number") @db.VarChar(20)
  /// OI-04
  preorderCutoffTime    DateTime? @map("preorder_cutoff_time") @db.Time(0)
  /// OI-02
  deliveryRadiusKm      Decimal?  @map("delivery_radius_km") @db.Decimal(5, 2)
  deliveryFeePerKm      Decimal?  @map("delivery_fee_per_km") @db.Decimal(12, 2)
  /// BR-06
  paymentTimeoutMinutes Int       @map("payment_timeout_minutes") @db.SmallInt
  /// BR-09
  earnAmountPerPoint    Decimal   @map("earn_amount_per_point") @db.Decimal(12, 2)
  redeemPointsUnit      Int       @map("redeem_points_unit")
  redeemValue           Decimal   @map("redeem_value") @db.Decimal(12, 2)
  goldMinPoints         Int       @map("gold_min_points")
  platinumMinPoints     Int       @map("platinum_min_points")
  /// BR-11
  reviewBonusPoints     Int       @map("review_bonus_points")

  @@map("store_settings")
}

/// Jam operasional per hari (1 Senin – 7 Minggu)
model OperatingHour {
  hourId    Int       @id @map("hour_id") @db.TinyInt
  dayOfWeek Int       @unique @map("day_of_week") @db.TinyInt
  openTime  DateTime? @map("open_time") @db.Time(0)
  closeTime DateTime? @map("close_time") @db.Time(0)
  isOpen    Boolean   @map("is_open")

  @@map("operating_hours")
}
